        br:concejal_gotzone_sagardui_goikoetxea,
        br:concejal_itxaso_erroteta_sagastagoya,
        br:concejal_itziar_urtasun_jimeno,
        br:concejal_jon_bilbao_urquijo,
        br:concejal_juan_ibarretxe_karetxe,
