    rdfs:domain bo:Proposicion,
        owl:Thing ;
    rdfs:range bo:Entidad,
        owl:Thing ;
    rdfs:subPropertyOf bo:menciona ;
    owl:equivalentProperty bo:menciona ;
    owl:sameAs bo:menciona .

