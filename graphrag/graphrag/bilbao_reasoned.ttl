bo:anio a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf bo:anio ;
    owl:equivalentProperty bo:anio ;
    owl:sameAs bo:anio .

bo:enPleno a owl:ObjectProperty ;
    rdfs:label "en pleno"@es ;
    rdfs:domain bo:Proposicion,
        owl:Thing ;
    rdfs:range bo:Pleno,
        owl:Thing ;
    rdfs:subPropertyOf bo:enPleno ;
    owl:equivalentProperty bo:enPleno ;
    owl:sameAs bo:enPleno .

bo:fecha a owl:DatatypeProperty ;
    rdfs:domain bo:Proposicion,
        owl:Thing ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf bo:fecha ;
    owl:equivalentProperty bo:fecha ;
    owl:sameAs bo:fecha .

