bo:trataSobre a owl:ObjectProperty ;
    rdfs:label "trata sobre"@es ;
    rdfs:domain bo:Proposicion,
        owl:Thing ;
    rdfs:range bo:Tema,
        owl:Thing ;
    rdfs:subPropertyOf bo:trataSobre,
        bo:trataTemaAmplio ;
    owl:equivalentProperty bo:trataSobre ;
    owl:sameAs bo:trataSobre .

bo:trataTemaAmplio a owl:ObjectProperty ;
    rdfs:label "trata sobre (incluye temas más amplios)"@es ;
    rdfs:subPropertyOf bo:trataTemaAmplio ;
    owl:equivalentProperty bo:trataTemaAmplio ;
    owl:propertyChainAxiom _:naf0284a506ff471499e71f25e2f0ebbeb1 ;
    owl:sameAs bo:trataTemaAmplio .

