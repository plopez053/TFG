        br:concejal_ana_vinals_blanco,
        br:concejal_bruno_zubizarreta_unanue,
        br:concejal_carmen_munoz_lopez,
        br:concejal_jone_goirizelaia_ordorika,
        br:concejal_xabier_jimenez_lopez ;
    bo:enPleno br:pleno_26_09_2019 ;
    bo:fecha "26-09-2019" ;
    bo:fuentePdf "actas\\2019\\26-09-2019_Ordinaria_Acta.pdf" ;
    bo:intervino br:concejal_alba_fatuarte_gonzalez,
        br:concejal_alfonso_gil_invernon,
        br:concejal_ana_vinals_blanco,
        br:concejal_carlos_david_garcia_fernandez,
        br:concejal_juan_maria_aburto_rique ;
    bo:menciona br:ent_abando,
        br:ent_casco_viejo,
        br:ent_gobierno_vasco,
        br:ent_indautxu,
        br:ent_madrid_central,
        br:ent_manuela_carmena,
        br:ent_san_francisco,
        br:ent_valle_del_bolintxu ;
    bo:pagina 328 ;
    bo:presentadaPor br:grupo_elkarrekin_bilbao ;
    bo:resultadoFuente "acta" ;
    bo:resumen "El Pleno insta al Equipo de Gobierno a impulsar un Plan de calidad del aire, cambio climático y resiliencia urbana con un proyecto de restricción del tráfico en el centro. El Equipo de Gobierno presenta una enmienda de modificación para seguir aplicando el PMUS (2015-2030) y los planes existentes." ;
    bo:tieneEnmienda br:enmienda_002f88e366b6adff ;
    bo:tieneResultado bo:Decae ;
    bo:tituloTopic "57. Proposición que presenta el Grupo Municipal ELKARREKIN BILBAO - PODEMOS/EZKER ANITZA/EQUO -BERDEAK, cuya parte dispositiva es del tenor  literal siguiente:          Udalbatzarreko Idazkaritza Nagu" ;
    bo:trataSobre br:t_002f88e366b6adff_cambio_climatico,
        br:t_calidad_aire,
        br:t_medioambiente,
        br:t_movilidad ;
    bo:trataTemaAmplio br:t_002f88e366b6adff_cambio_climatico,
        br:t_calidad_aire,
        br:t_medioambiente,
        br:t_movilidad ;
    bo:votoAFavorDe br:grupo_eaj_pnv,
        br:grupo_pp,
        br:grupo_pse_ee ;
    bo:votoEnContraDe br:grupo_eh_bildu,
        br:grupo_elkarrekin_bilbao ;
    bo:votoFuente "acta" ;
    bo:votoTexto "se acepta la enmienda de modificación del EQUIPO DE GOBIERNO, por lo que decae la proposición presentada por el Grupo Municipal ELKARREKIN BILBAO-PODEMOS/EZKER ANITZA-IU/ EQUO-BERDEAK (Votos emitidos: 29 | a favor: 22, en contra: 7)" ;
    bo:votosContra 7 ;
    bo:votosFavor 22 ;
    owl:sameAs br:prop_002f88e366b6adff .

