@prefix bo:   <http://bilbao.tfg/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontología del dominio: Plenos del Ayuntamiento de Bilbao
# TBox: clases, jerarquías, propiedades y axiomas para el razonador OWL-RL.
#################################################################

bo: a owl:Ontology ;
    rdfs:label "Ontología de los Plenos del Ayuntamiento de Bilbao"@es ;
    rdfs:comment "Modela proposiciones, grupos, plenos, temas (SKOS) y entidades para GraphRAG."@es .

### --------------------------------------------------------------
### CLASES
### --------------------------------------------------------------
bo:Proposicion a owl:Class ; rdfs:label "Proposición"@es .
bo:Pleno       a owl:Class ; rdfs:label "Pleno (sesión)"@es .
bo:Grupo       a owl:Class ; rdfs:label "Grupo municipal"@es .
bo:Resultado   a owl:Class ; rdfs:label "Resultado de votación"@es .
bo:Tema        a owl:Class ; rdfs:label "Tema"@es ;
    rdfs:comment "Tema tratado; los individuos son skos:Concept en una taxonomía."@es .

bo:Entidad     a owl:Class ; rdfs:label "Entidad mencionada"@es .
bo:Persona      a owl:Class ; rdfs:subClassOf bo:Entidad ; rdfs:label "Persona"@es .
bo:Lugar        a owl:Class ; rdfs:subClassOf bo:Entidad ; rdfs:label "Lugar"@es .
bo:Organizacion a owl:Class ; rdfs:subClassOf bo:Entidad ; rdfs:label "Organización"@es .

bo:Concejal a owl:Class ; rdfs:subClassOf bo:Persona ; rdfs:label "Concejal/a"@es ;
    rdfs:comment "Miembro de la corporación municipal. Al ser subclase de Persona, las consultas por bo:menciona + bo:Persona lo siguen recogiendo."@es .
bo:PersonalTecnico a owl:Class ; rdfs:subClassOf bo:Persona ; rdfs:label "Personal técnico del Pleno"@es ;
    rdfs:comment "Secretario General, Interventor... Asisten a todos los plenos pero NO son cargos electos: no votan, no proponen, no debaten políticamente."@es .
bo:Enmienda a owl:Class ; rdfs:label "Enmienda a una proposición"@es .

### --------------------------------------------------------------
### PROPIEDADES DE OBJETO (con dominio/rango)
### --------------------------------------------------------------
bo:presentadaPor a owl:ObjectProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range bo:Grupo ;
    rdfs:label "presentada por"@es .

# Distinta de bo:presentadaPor: cubre las proposiciones que NO presenta un
# grupo político sino un particular, una asociación vecinal, una AMPA o una
# comunidad de propietarios (mecanismo de "proposición ciudadana" del ROM).
bo:presentadaPorParticular a owl:ObjectProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range bo:Entidad ;
    rdfs:label "presentada por (particular/asociación)"@es .

bo:enPleno a owl:ObjectProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range bo:Pleno ;
    rdfs:label "en pleno"@es .

bo:tieneResultado a owl:ObjectProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range bo:Resultado ;
    rdfs:label "tiene resultado"@es .

bo:menciona a owl:ObjectProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range bo:Entidad ;
    rdfs:label "menciona"@es .

bo:trataSobre a owl:ObjectProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range bo:Tema ;
    rdfs:label "trata sobre"@es .

### --- concejales ---
bo:perteneceA a owl:ObjectProperty ;
    rdfs:domain bo:Concejal ; rdfs:range bo:Grupo ;
    rdfs:label "pertenece al grupo"@es .
bo:esAlcalde a owl:DatatypeProperty ;
    rdfs:domain bo:Concejal ; rdfs:range xsd:boolean ;
    rdfs:label "ha sido alcalde/sa"@es .
bo:cargoTecnico a owl:DatatypeProperty ;
    rdfs:domain bo:PersonalTecnico ; rdfs:range xsd:string ;
    rdfs:label "cargo (Secretario General / Interventor...)"@es .
bo:intervino a owl:ObjectProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range bo:Concejal ;
    rdfs:label "intervino en el debate"@es .
bo:proponePersona a owl:ObjectProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range bo:Concejal ;
    rdfs:label "proponente (persona que firma)"@es .

### --- voto por grupo (propiedades directas Proposición -> Grupo) ---
bo:votoAFavorDe a owl:ObjectProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range bo:Grupo ;
    rdfs:label "votó a favor el grupo"@es .
bo:votoEnContraDe a owl:ObjectProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range bo:Grupo ;
    rdfs:label "votó en contra el grupo"@es .
bo:seAbstuvo a owl:ObjectProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range bo:Grupo ;
    rdfs:label "se abstuvo el grupo"@es .

### --- voto NOMINAL (por concejal) — capa determinista, parseado del acta ---
bo:concejalVotoAFavor a owl:ObjectProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range bo:Concejal ;
    rdfs:label "votó a favor el concejal"@es .
bo:concejalVotoEnContra a owl:ObjectProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range bo:Concejal ;
    rdfs:label "votó en contra el concejal"@es .
bo:concejalVotoAbstencion a owl:ObjectProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range bo:Concejal ;
    rdfs:label "se abstuvo el concejal"@es .
bo:votoFuente a owl:DatatypeProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range xsd:string ;
    rdfs:label "procedencia del voto (acta | llm)"@es .
bo:resultadoFuente a owl:DatatypeProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range xsd:string ;
    rdfs:label "procedencia del resultado (acta | llm)"@es .

### --- enmiendas ---
bo:tieneEnmienda a owl:ObjectProperty ;
    rdfs:domain bo:Proposicion ; rdfs:range bo:Enmienda ;
    rdfs:label "tiene enmienda"@es .
bo:enmiendaPor a owl:ObjectProperty ;
    rdfs:domain bo:Enmienda ; rdfs:range bo:Grupo ;
    rdfs:label "enmienda presentada por"@es .

### --------------------------------------------------------------
### RAZONAMIENTO: roll-up temático
### "vivienda social" ⊑ "vivienda" ⇒ una pregunta por "vivienda"
### agrega automáticamente las proposiciones de sus subtemas.
### Se materializa con OWL-RL (TransitiveProperty + propertyChainAxiom).
### --------------------------------------------------------------
# broaderT = cierre transitivo de skos:broader
bo:broaderT a owl:ObjectProperty, owl:TransitiveProperty ;
    rdfs:label "tema más amplio (transitivo)"@es .
skos:broader rdfs:subPropertyOf bo:broaderT .

# trataTemaAmplio = trataSobre seguido de (0..n) saltos broaderT
bo:trataTemaAmplio a owl:ObjectProperty ;
    rdfs:label "trata sobre (incluye temas más amplios)"@es ;
    owl:propertyChainAxiom ( bo:trataSobre bo:broaderT ) .
bo:trataSobre rdfs:subPropertyOf bo:trataTemaAmplio .

### --------------------------------------------------------------
### PROPIEDADES DE DATOS
### --------------------------------------------------------------
bo:fecha        a owl:DatatypeProperty ; rdfs:domain bo:Proposicion ; rdfs:range xsd:string .
bo:anio         a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Sin rdfs:domain a propósito: se usa en Proposicion Y en Pleno; un domain haría que el razonador infiriera que cada Pleno es una Proposicion."@es .
bo:tituloTopic  a owl:DatatypeProperty ; rdfs:domain bo:Proposicion ; rdfs:range xsd:string .
bo:resumen      a owl:DatatypeProperty ; rdfs:domain bo:Proposicion ; rdfs:range xsd:string ;
    rdfs:label "resumen de la parte dispositiva"@es .
bo:pagina       a owl:DatatypeProperty ; rdfs:domain bo:Proposicion ; rdfs:range xsd:integer .
bo:fuentePdf    a owl:DatatypeProperty ; rdfs:domain bo:Proposicion ; rdfs:range xsd:string .
bo:votosFavor   a owl:DatatypeProperty ; rdfs:domain bo:Proposicion ; rdfs:range xsd:integer .
bo:votosContra  a owl:DatatypeProperty ; rdfs:domain bo:Proposicion ; rdfs:range xsd:integer .
bo:votoTexto    a owl:DatatypeProperty ; rdfs:domain bo:Proposicion ; rdfs:range xsd:string .
bo:resumenEnmienda a owl:DatatypeProperty ; rdfs:domain bo:Enmienda ; rdfs:range xsd:string .
bo:tipoEnmienda    a owl:DatatypeProperty ; rdfs:domain bo:Enmienda ; rdfs:range xsd:string .
bo:resultadoEnmienda a owl:DatatypeProperty ; rdfs:domain bo:Enmienda ; rdfs:range xsd:string ;
    rdfs:label "resultado de la enmienda"@es ;
    rdfs:comment "aceptada_por_proponente | aprobada_en_votacion | rechazada_en_votacion | sin_votar"@es .
bo:votosFavorEnmienda  a owl:DatatypeProperty ; rdfs:domain bo:Enmienda ; rdfs:range xsd:integer .
bo:votosContraEnmienda a owl:DatatypeProperty ; rdfs:domain bo:Enmienda ; rdfs:range xsd:integer .

### --------------------------------------------------------------
### INDIVIDUOS FIJOS: resultados de votación
### --------------------------------------------------------------
bo:Aprobada           a bo:Resultado ; skos:prefLabel "aprobada"@es .
bo:Rechazada          a bo:Resultado ; skos:prefLabel "rechazada"@es .
bo:Decae              a bo:Resultado ; skos:prefLabel "decae"@es .
bo:Retirada           a bo:Resultado ; skos:prefLabel "retirada"@es .
bo:AprobadaConEnmienda a bo:Resultado ; skos:prefLabel "aprobada con enmienda"@es .
bo:SinResultado       a bo:Resultado ; skos:prefLabel "sin resultado"@es .
